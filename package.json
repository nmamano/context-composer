{
  "name": "context-composer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Context Composer — Phase 1 tracer bullet: rendered-context-boundary proxy + frame engine + ctx CLI",
  "scripts": {
    "proxy": "bun run src/proxy/server.ts",
    "ctx": "bun run src/cli/ctx.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui",
    "demo": "bun run scripts/phase1-walkthrough.ts",
    "ui:build": "bun build ui/index.html --outdir ui/dist --public-path=/ui/",
    "ui:smoke": "bash scripts/ui-smoke.sh"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.10.2",
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "happy-dom": "20.10.2",
    "playwright": "1.60.0"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
